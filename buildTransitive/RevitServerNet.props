<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Bundled Autodesk Revit Server client assemblies of the package: copied to <output>\RSAssemblies\ on build
       and to <publish>\RSAssemblies\ on publish, where the direct export looks for them. With PublishSingleFile they stay
       files next to the executable (the loader cannot load them from the bundle).
       To turn the copy off, declare an empty target with the same name in the project: <Target Name="RevitServerNet_CopyRSAssembliesForConsumers" /> -->
  <Target Name="RevitServerNet_CopyRSAssembliesForConsumers" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_RevitServerNetRSAssembly Include="$(MSBuildThisFileDirectory)..\RSAssemblies\*.dll" />
      <None Include="@(_RevitServerNetRSAssembly)">
        <Link>RSAssemblies\%(_RevitServerNetRSAssembly.Filename)%(_RevitServerNetRSAssembly.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <Visible>false</Visible>
        <Pack>false</Pack>
      </None>
    </ItemGroup>
  </Target>
</Project>
